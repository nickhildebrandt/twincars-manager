{
  "name": "twincars-manager",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:befunde && pnpm test:modell && pnpm docs:check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:integration": "vitest run --project integration",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test",
    "test:cov": "vitest run --coverage",
    "test:cov:update": "COV_UPDATE=1 vitest run --coverage",
    "test:befunde": "node scripts/check-befunde.mjs",
    "test:db:reset": "node scripts/test-db.mjs reset",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:api": "node scripts/docs-api.mjs",
    "docs:data": "node scripts/docs-data.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/seed.mjs",
    "test:watch": "vitest --project unit --project nuxt",
    "test:db:status": "node scripts/test-db.mjs status",
    "docs:features": "node scripts/docs-features.mjs",
    "docs:build": "pnpm docs:features && pnpm docs:api && pnpm docs:data && pnpm docs:domain",
    "db:idempotent": "node scripts/make-migration-idempotent.mjs",
    "docs:domain": "node --experimental-strip-types scripts/docs-domain.mjs",
    "pretest": "node scripts/warm-vite-cache.mjs",
    "test:modell": "node scripts/check-modell.mjs",
    "pretest:cov": "node scripts/warm-vite-cache.mjs --coverage",
    "pretest:cov:update": "node scripts/warm-vite-cache.mjs --coverage",
    "pretest:browser": "node scripts/warm-vite-cache.mjs"
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue,json,md,yaml,yml,css}": "eslint --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.63.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.5",
    "husky": "9.1.7",
    "lint-staged": "^17.5.1",
    "playwright-core": "^1.63.0",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.131",
    "@internationalized/date": "^3.12.4",
    "@nuxt/ui": "^4.11.1",
    "@valibot/i18n": "^1.2.0",
    "better-auth": "^1.7.4",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.45.2",
    "h3": "1.15.11",
    "nuxt": "^4.5.2",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "valibot": "^1.5.0",
    "vue": "^3.5.42",
    "vue-router": "^4.5.0"
  },
  "imports": {
    "#shared/*": "./shared/*.ts"
  }
}
