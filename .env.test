# Test environment. Committed on purpose: it holds no real secrets.
# CI overrides DATABASE_URL with the service-container connection string.
NODE_ENV=test

# Appointment slots and ledger period boundaries depend on this.
TZ=Europe/Berlin

# Local development connects through the unix socket (peer authentication),
# because that role is allowed to create the per-worker test databases.
DATABASE_URL=postgres:///twincars_test?host=/var/run/postgresql

APP_SECRET=test-secret-please-do-not-use-in-production-0000
APP_ENCRYPTION_KEY=test-encryption-key-0000000000000000000000
ORIGIN=http://localhost:3000
API_TOKENS=test-token-aaaaaaaaaaaaaaaa
EBAY_VERIFICATION_TOKEN=test-verification-token-aaaaaaaaaaaaaaaa
