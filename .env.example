DATABASE_URL=postgres://admin:TwinCars2026!@localhost:5432/twincars-manager
APP_SECRET=please-change-me-in-production-32bytes
# Do NOT set NODE_ENV here: vite picks the mode itself, and a fixed
# NODE_ENV=development in .env silently turns `pnpm build` into a
# development-flagged bundle (dev===true in $app/environment).

# Public base URL the app is served from. better-auth uses this for
# cookie domain handling. Defaults to http://localhost:5173 in dev.
# In production set this to e.g. https://tc.ts13.de (see ORIGIN block
# below — they should match the same origin).
BETTER_AUTH_URL=http://localhost:5173

# Comma-separated list of Bearer tokens that grant access to the
# public REST API (/api/public/*). Tokens are accepted from the moment
# the server starts — no admin UI, no minting workflow. Each entry
# should be a cryptographically random string of at least 16 chars;
# entries shorter than 8 chars are silently ignored. Newlines and
# semicolons also work as separators (handy for multi-line secret-
# manager entries). Leave empty to fail-closed (every request rejected).
API_TOKENS=

# ── eBay integration ─────────────────────────────────────────────────
# Marketplace Account Deletion compliance endpoint
# (/api/ebay/account-deletion). EBAY_VERIFICATION_TOKEN is the shared
# secret (32–80 chars, [A-Za-z0-9_-]) you ALSO paste into the eBay
# developer portal under Alerts & Notifications → Marketplace Account
# Deletion. Unset → the endpoint fails closed (503).
EBAY_VERIFICATION_TOKEN=
# Optional: the exact endpoint URL as registered in the portal — only
# needed when it differs from ORIGIN + path (the challenge hash must
# match the registered URL byte-for-byte).
EBAY_DELETION_ENDPOINT_URL=
# OAuth (Authorization Code Grant) for connecting the seller account
# under /settings/ebay. Values come from the eBay developer portal:
# App ID (Client ID), Cert ID (Client Secret) and the RuName created
# on the "User Tokens" page. EBAY_ENV switches to the sandbox world
# (default: production). Tokens at rest are AES-256-GCM-encrypted
# with APP_ENCRYPTION_KEY (fallback: APP_SECRET).
EBAY_CLIENT_ID=
EBAY_CERT_ID=
EBAY_RU_NAME=
#EBAY_ENV=sandbox

# ─────────────────────────────────────────────────────────────────────
# Production note (tc.ts13.de)
#
# In production these are set on the host in /etc/twincars/env/manager.env
# (mode 600, root-owned) by `deploy/scripts/provision.sh` — do NOT commit
# real values to this repo. The provisioning script generates
# APP_ENCRYPTION_KEY and the Postgres password once, prints them to the
# operator, and stores them on the server only.
#
# Production additionally sets:
#   ORIGIN=https://tc.ts13.de:5443
#   BODY_SIZE_LIMIT=67108864   (64 MiB, for the legacy .mdb import)
#   HOST=0.0.0.0
#   PORT=3000
# ─────────────────────────────────────────────────────────────────────
