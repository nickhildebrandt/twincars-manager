{
  "name": "twincars-manager",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check",
    "test": "node scripts/not-yet.mjs test",
    "test:unit": "node scripts/not-yet.mjs test:unit",
    "test:nuxt": "node scripts/not-yet.mjs test:nuxt",
    "test:integration": "node scripts/not-yet.mjs test:integration",
    "test:browser": "node scripts/not-yet.mjs test:browser",
    "test:e2e": "node scripts/not-yet.mjs test:e2e",
    "test:cov": "node scripts/not-yet.mjs test:cov",
    "test:cov:update": "node scripts/not-yet.mjs test:cov:update",
    "test:befunde": "node scripts/not-yet.mjs test:befunde",
    "test:db:reset": "node scripts/not-yet.mjs test:db:reset",
    "docs:check": "node scripts/not-yet.mjs docs:check",
    "docs:api": "node scripts/not-yet.mjs docs:api",
    "docs:data": "node scripts/not-yet.mjs docs:data",
    "db:generate": "node scripts/not-yet.mjs db:generate",
    "db:migrate": "node scripts/not-yet.mjs db:migrate",
    "db:studio": "node scripts/not-yet.mjs db:studio",
    "db:seed": "node scripts/not-yet.mjs db:seed"
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue,json,md,yaml,yml,css}": "eslint --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nuxt/eslint": "^1.17.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "eslint": "^10.10.0",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.131",
    "@nuxt/ui": "^4.11.1",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^4.5.0"
  }
}
