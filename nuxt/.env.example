# Copy to .env and fill in. The application refuses to start when a required
# value is missing or implausible (docs/rewrite/03-architektur.md §6.6).

# --- required -------------------------------------------------------------
# PostgreSQL connection string. No default exists, on purpose.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/twincars

# Session cookie secret, at least 32 characters. Generate with:
#   openssl rand -hex 32
APP_SECRET=

# Fixed, because appointment slots and ledger period boundaries depend on it.
TZ=Europe/Berlin

# --- required in production ----------------------------------------------
# Absolute public URL of this installation.
ORIGIN=http://localhost:3000

# AES-256-GCM key for secrets stored in the database (SMTP password, eBay
# tokens). In development it falls back to APP_SECRET.
APP_ENCRYPTION_KEY=

# --- optional -------------------------------------------------------------
# Bearer tokens for /api/public/*, comma separated, each at least 16 chars.
# Empty means the public API answers 503 instead of silently rejecting.
API_TOKENS=

# eBay. Either all four are set or none of them.
EBAY_CLIENT_ID=
EBAY_CERT_ID=
EBAY_RU_NAME=
EBAY_ENV=production

# eBay marketplace account deletion endpoint (32-80 characters).
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT_URL=

# Recurring work runs weekdays at 07:30 Europe/Berlin. Set to "off" to silence
# the schedule on a staging instance; the "Jetzt prüfen" buttons keep working.
TASKS_SCHEDULE=on
